REACT_APP_API_URL=http://localhost:8080

# Use uma porta diferente do backend principal se o nfse-service tambem rodar local.
REACT_APP_NFSE_API_URL=http://localhost:8081

# Chave interna do nfse-service. Em producao, prefira chamar via backend/proxy,
# nao expor uma chave sensivel no bundle do navegador.
REACT_APP_NFSE_API_KEY=

# Opcional enquanto o codigo de servico nao estiver persistido no pedido.
REACT_APP_NFSE_CODIGO_SERVICO=
